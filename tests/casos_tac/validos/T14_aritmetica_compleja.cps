let a: integer = 2; let b: integer = 3; let c: integer = 4; let d: integer = 5;
let e: integer = 6; let f: integer = 7; let g: integer = 8; let h: integer = 9;
let r: integer = (a + b) * (c + d) - (e + f) * (g - h);
print(r);
let s: integer = a + b + c + d + e + f + g + h;
print(s);
let u: integer = -a * (b - -c) % 5;
print(u);
print((a + b) * ((c + d) * ((e + f) * (g + h))));
